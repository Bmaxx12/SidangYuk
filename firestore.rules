rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Context Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Sessions Rules
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() 
        && isValidId(sessionId)
        && incoming().userId == request.auth.uid
        && incoming().judul is string && incoming().judul.size() <= 500
        && incoming().abstrak is string && incoming().abstrak.size() <= 5000
        && incoming().dosenType is string && incoming().dosenType.size() <= 50
        && incoming().status in ['setup', 'inprogress', 'verdict']
        && incoming().createdAt is string && incoming().createdAt.size() <= 100;
        
      allow update: if isSignedIn()
        && (existing().userId == request.auth.uid)
        && incoming().userId == existing().userId
        && incoming().judul == existing().judul
        && incoming().abstrak == existing().abstrak
        && incoming().dosenType == existing().dosenType
        && incoming().status in ['setup', 'inprogress', 'verdict']
        // Action status transitions or question index updates
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentQuestionIndex']);
        
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid);

      // Questions Subcollection
      match /questions/{questionId} {
        allow get, list: if isSignedIn() && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid);
        
        allow create: if isSignedIn()
          && isValidId(questionId)
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid)
          && incoming().sessionId == sessionId
          && incoming().orderNum is int
          && incoming().questionText is string && incoming().questionText.size() <= 2000
          && incoming().isFollowup is bool;
          
        allow update: if isSignedIn()
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid)
          && incoming().sessionId == existing().sessionId
          && incoming().orderNum == existing().orderNum
          && incoming().questionText == existing().questionText
          && incoming().isFollowup == existing().isFollowup
          && incoming().diff(existing()).affectedKeys().hasOnly(['transcript', 'wpm', 'fillerCount', 'fillerWords', 'aiScore', 'aiFeedback']);
          
        allow delete: if isSignedIn() && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid);
      }

      // Verdicts Subcollection
      match /verdicts/{verdictId} {
        allow get, list: if isSignedIn() && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid);
        
        allow create: if isSignedIn()
          && isValidId(verdictId)
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid)
          && incoming().sessionId == sessionId
          && incoming().overallScore is int && incoming().overallScore >= 0 && incoming().overallScore <= 100
          && incoming().result is string && incoming().result.size() <= 100
          && incoming().scoreMateri is int && incoming().scoreMateri >= 0 && incoming().scoreMateri <= 100
          && incoming().scoreMetodologi is int && incoming().scoreMetodologi >= 0 && incoming().scoreMetodologi <= 100
          && incoming().scoreArgumentasi is int && incoming().scoreArgumentasi >= 0 && incoming().scoreArgumentasi <= 100
          && incoming().scoreKontribusi is int && incoming().scoreKontribusi >= 0 && incoming().scoreKontribusi <= 100
          && incoming().scoreTekanan is int && incoming().scoreTekanan >= 0 && incoming().scoreTekanan <= 100
          && incoming().catatanDosen is string && incoming().catatanDosen.size() <= 10000;
          
        allow update, delete: if false; // Verdict is immutable once written
      }
    }
  }
}
