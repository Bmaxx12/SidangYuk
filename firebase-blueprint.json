{
  "entities": {
    "session": {
      "title": "SidangSession",
      "description": "Represents a thesis defense session structure",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique ID of the session"
        },
        "userId": {
          "type": "string",
          "description": "Anonymous or authenticated firebase user ID"
        },
        "judul": {
          "type": "string",
          "description": "Thesis Title"
        },
        "abstrak": {
          "type": "string",
          "description": "Thesis Abstract"
        },
        "dosenType": {
          "type": "string",
          "description": "The selected lecturer style"
        },
        "status": {
          "type": "string",
          "description": "Current status of the sidang: 'setup', 'inprogress', 'verdict'"
        },
        "currentQuestionIndex": {
          "type": "integer",
          "description": "Index of current question"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when session created"
        }
      },
      "required": ["id", "userId", "judul", "abstrak", "dosenType", "status", "createdAt"]
    },
    "question": {
      "title": "SidangQuestion",
      "description": "Represents a generated question and its answer details within a session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique ID of the question"
        },
        "sessionId": {
          "type": "string",
          "description": "Reference to the session"
        },
        "orderNum": {
          "type": "integer",
          "description": "Question order"
        },
        "questionText": {
          "type": "string",
          "description": "The text of the question generated by AI"
        },
        "isFollowup": {
          "type": "boolean",
          "description": "Whether this is an adaptive follow-up"
        },
        "transcript": {
          "type": "string",
          "description": "Raw answered text"
        },
        "wpm": {
          "type": "integer",
          "description": "Words per minute"
        },
        "fillerCount": {
          "type": "integer",
          "description": "Total count of detected filler words"
        },
        "fillerWords": {
          "type": "object",
          "description": "Breakdown map of detected filler words"
        },
        "aiScore": {
          "type": "integer",
          "description": "Sub-score of the answer"
        },
        "aiFeedback": {
          "type": "string",
          "description": "Short feedback on the answer"
        }
      },
      "required": ["id", "sessionId", "orderNum", "questionText", "isFollowup"]
    },
    "verdict": {
      "title": "SidangVerdict",
      "description": "Final thesis defense results and analytics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Verdict ID matching or linked to sessionId"
        },
        "sessionId": {
          "type": "string",
          "description": "Linked session"
        },
        "overallScore": {
          "type": "integer",
          "description": "Overall percentage score (0-100)"
        },
        "result": {
          "type": "string",
          "description": "LULUS CUM LAUDE, LULUS, REVISI MAYOR, TIDAK LULUS"
        },
        "scoreMateri": {
          "type": "integer",
          "description": "Score for thesis content depth"
        },
        "scoreMetodologi": {
          "type": "integer",
          "description": "Score for research methodology"
        },
        "scoreArgumentasi": {
          "type": "integer",
          "description": "Score for answering and defense confidence"
        },
        "scoreKontribusi": {
          "type": "integer",
          "description": "Score for academic or industrial contribution"
        },
        "scoreTekanan": {
          "type": "integer",
          "description": "Score for calmness and filler avoidance"
        },
        "catatanDosen": {
          "type": "string",
          "description": "Lecturer critique and summary feedback"
        }
      },
      "required": ["id", "sessionId", "overallScore", "result", "scoreMateri", "scoreMetodologi", "scoreArgumentasi", "scoreKontribusi", "scoreTekanan", "catatanDosen"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": "session",
      "description": "Active and completed sidang sessions"
    },
    "/sessions/{sessionId}/questions/{questionId}": {
      "schema": "question",
      "description": "Questions and answers for a session"
    },
    "/sessions/{sessionId}/verdicts/{verdictId}": {
      "schema": "verdict",
      "description": "Verdict report for a session"
    }
  }
}
